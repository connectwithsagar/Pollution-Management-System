# GEMINI_API_KEY: Required for Gemini AI API calls if optional AI summary features are enabled.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OPENAQ_API_KEY: Optional API key for OpenAQ v3 ground monitoring stations (https://explore.openaq.org).
# Sensor.Community and Open-Meteo work without an API key.
OPENAQ_API_KEY=""

# JWT_SECRET: Secret key used to sign session tokens for email/password authentication.
JWT_SECRET="change-me-in-production"

# IOT_INGEST_KEY: Optional shared secret for authenticating ESP32 IoT sensor HTTP uploads.
IOT_INGEST_KEY=""

# REFRESH_INTERVAL_MS: Live environmental polling interval in milliseconds (default 300000 = 5 minutes).
REFRESH_INTERVAL_MS="300000"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key for interactive Live Pollution Map.
# AI Studio automatically injects the provisioned Maps API key at runtime.
VITE_GOOGLE_MAPS_API_KEY=""

